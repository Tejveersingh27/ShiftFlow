@*
    Small snippet shown in the top nav bar.
    - If the visitor is signed in  -> greet them + a "Log out" button
    - If not                       -> "Register" and "Log in" links
    SignInManager / UserManager are the two main Identity services; we inject
    them straight into the view here because this partial's only job is UI.
*@
@using Microsoft.AspNetCore.Identity
@using ShiftFlow.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    // FullName is a ShiftFlow-specific field (not part of Identity's default
    // model), so we look up the full user record instead of using the cookie's
    // built-in User.Identity.Name (which is just the username/email).
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var displayName = string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser?.Email : currentUser.FullName;
}
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @displayName!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="nav-link btn btn-link text-dark border-0">Log out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    </li>
}
</ul>
