@model List<Department>
@{
    ViewData["Title"] = "Departments";
    var organizationId = (Guid)ViewData["OrganizationId"]!;
    var isManager = (bool)ViewData["IsManager"]!;
}

<h1 class="h3 mb-3">Departments</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No departments yet.</p>
}
else
{
    <ul class="list-group mb-4" style="max-width: 480px;">
        @foreach (var d in Model)
        {
            <li class="list-group-item">
                @if (isManager)
                {
                    <form asp-controller="Departments" asp-action="Rename" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="departmentId" value="@d.Id" />
                        <input type="hidden" name="organizationId" value="@organizationId" />
                        <input type="text" name="name" value="@d.Name" class="form-control form-control-sm" required minlength="2" maxlength="50" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                    </form>
                }
                else
                {
                    @d.Name
                }
            </li>
        }
    </ul>
}

@if (isManager)
{
    <h2 class="h5 mb-3">Add a department</h2>
    <form asp-controller="Departments" asp-action="Create" method="post" class="row g-2 align-items-end" style="max-width: 480px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrganizationId" value="@organizationId" />

        <div class="col-sm-8">
            <label class="form-label">Name</label>
            <input type="text" name="Name" class="form-control" required minlength="2" maxlength="50" />
        </div>

        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary w-100">Add</button>
        </div>
    </form>
}
