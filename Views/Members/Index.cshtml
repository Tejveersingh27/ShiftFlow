@model List<OrganizationMember>
@{
    ViewData["Title"] = "Team";
    var organizationId = (Guid)ViewData["OrganizationId"]!;
    var isManager = (bool)ViewData["IsManager"]!;
    var departments = (List<Department>)ViewData["Departments"]!;
    var pendingMembers = (List<OrganizationMember>)ViewData["PendingMembers"]!;
}

<h1 class="h3 mb-3">Team</h1>

@if (isManager && pendingMembers.Any())
{
    <div class="mb-4">
        <h2 class="h6 text-muted mb-2">Pending requests</h2>
        <div style="max-width: 640px;">
            @foreach (var p in pendingMembers)
            {
                <div class="shift-row">
                    <span>@(string.IsNullOrWhiteSpace(p.User.FullName) ? p.User.Email : p.User.FullName)</span>
                    <span>
                        <form asp-controller="Members" asp-action="Approve" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="membershipId" value="@p.Id" />
                            <input type="hidden" name="organizationId" value="@organizationId" />
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-controller="Members" asp-action="Reject" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="membershipId" value="@p.Id" />
                            <input type="hidden" name="organizationId" value="@organizationId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    </span>
                </div>
            }
        </div>
    </div>
}

<table class="table align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Email</th>
            <th>Role</th>
            <th>Department</th>
            <th>Joined</th>
            @if (isManager)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td class="text-muted">@m.EmployeeNumber</td>
                <td>
                    @if (isManager)
                    {
                        <a asp-controller="Members" asp-action="Details" asp-route-membershipId="@m.Id" asp-route-organizationId="@organizationId">
                            @(string.IsNullOrWhiteSpace(m.User.FullName) ? m.User.Email : m.User.FullName)
                        </a>
                    }
                    else
                    {
                        @(string.IsNullOrWhiteSpace(m.User.FullName) ? m.User.Email : m.User.FullName)
                    }
                </td>
                <td><span class="badge bg-secondary">@m.Role</span></td>
                <td>@(m.Department?.Name ?? "—")</td>
                <td>@m.JoinedAtUtc.ToString("MMM d, yyyy")</td>
                @if (isManager)
                {
                    <td>
                        @if (m.Role != OrganizationRole.Owner)
                        {
                            <form asp-controller="Members" asp-action="Remove" method="post"
                                  onsubmit="return confirm('Remove this person from the organization?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="membershipId" value="@m.Id" />
                                <input type="hidden" name="organizationId" value="@organizationId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (isManager)
{
    <hr class="my-4" />

    <h2 class="h5 mb-3">Add a member</h2>
    <p class="text-muted small">The person must already have a ShiftFlow account.</p>

    <form asp-controller="Members" asp-action="Add" method="post" class="row g-2 align-items-end" style="max-width: 560px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrganizationId" value="@organizationId" />

        <div class="col-sm-6">
            <label class="form-label">Email</label>
            <input type="email" name="Email" class="form-control" required />
        </div>

        <div class="col-sm-4">
            <label class="form-label">Role</label>
            <select name="Role" class="form-select">
                <option value="@OrganizationRole.Manager">Manager</option>
                <option value="@OrganizationRole.Employee" selected>Employee</option>
            </select>
        </div>

        <div class="col-sm-4">
            <label class="form-label">Department</label>
            <select name="DepartmentId" class="form-select">
                <option value="">— None —</option>
                @foreach (var d in departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>

        <div class="col-sm-2">
            <button type="submit" class="btn btn-primary w-100">Add</button>
        </div>
    </form>
}
