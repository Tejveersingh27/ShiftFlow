@model List<MyScheduleCardViewModel>
@{
    ViewData["Title"] = "Home";
}

@if (!User.Identity?.IsAuthenticated ?? true)
{
    <div class="text-center">
        <h1 class="display-6 mb-3">Welcome to ShiftFlow</h1>
        <p class="text-muted">Log in to see your schedule.</p>
    </div>
}
else if (!Model.Any())
{
    <div class="text-center">
        <h1 class="display-6 mb-3">Welcome to ShiftFlow</h1>
        <p class="text-muted">You're not part of an organization yet.</p>
        <a asp-controller="Organizations" asp-action="Index" class="btn btn-primary">Go to Organizations</a>
    </div>
}
else
{
    <h1 class="h3 mb-3">Home</h1>
    <div class="row g-3">
        @foreach (var card in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="h6 mb-0">My Schedule</h2>
                            <a asp-controller="Schedules" asp-action="My" asp-route-organizationId="@card.OrganizationId" class="small">
                                See all &rarr;
                            </a>
                        </div>
                        <p class="text-muted small mb-3">@card.OrganizationName</p>

                        @if (!card.UpcomingShifts.Any())
                        {
                            <p class="text-muted small mb-0">You have nothing planned.</p>
                        }
                        else
                        {
                            @foreach (var shift in card.UpcomingShifts)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small">@shift.StartsAtUtc.ToString("ddd, MMM d")</span>
                                    <span class="shift-chip">@shift.StartsAtUtc.ToString("h:mm tt") – @shift.EndsAtUtc.ToString("h:mm tt")</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
