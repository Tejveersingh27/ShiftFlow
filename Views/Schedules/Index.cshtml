@model List<Schedule>
@{
    ViewData["Title"] = "Schedules";
    var organizationId = (Guid)ViewData["OrganizationId"]!;
    var isManager = (bool)ViewData["IsManager"]!;
}

<h1 class="h3 mb-3">Schedules</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No schedules yet.</p>
}
else
{
    <div class="list-group mb-4" style="max-width: 480px;">
        @foreach (var s in Model)
        {
            <a asp-controller="Schedules" asp-action="Details" asp-route-id="@s.Id"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <span>Week of @s.WeekStartDate.ToString("MMM d, yyyy")</span>
                <span class="badge @(s.Status == ScheduleStatus.Published ? "bg-success" : "bg-secondary")">@s.Status</span>
            </a>
        }
    </div>
}

@if (isManager)
{
    <h2 class="h5 mb-3">New schedule</h2>
    <form asp-controller="Schedules" asp-action="Create" method="post" class="row g-2 align-items-end" style="max-width: 480px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrganizationId" value="@organizationId" />

        <div class="col-sm-8">
            <label class="form-label">Week starting (Monday)</label>
            <input type="date" name="WeekStartDate" class="form-control" required />
        </div>

        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary w-100">Create</button>
        </div>
    </form>
}
