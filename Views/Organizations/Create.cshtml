@model CreateOrganizationViewModel
@{
    ViewData["Title"] = "New organization";
}

<div class="row">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-1">Create an organization</h1>
        <p class="text-muted">You'll be the owner and can invite managers and employees.</p>

        <form asp-controller="Organizations" asp-action="Create" method="post" class="mt-3">
            @* Renders a hidden anti-CSRF token; [ValidateAntiForgeryToken] on the action checks it. *@
            @Html.AntiForgeryToken()

            @* Summary of any validation errors not tied to a single field. *@
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create organization</button>
        </form>
    </div>
</div>

@section Scripts {
    @* Enables client-side validation (instant feedback before submitting). *@
    <partial name="_ValidationScriptsPartial" />
}
